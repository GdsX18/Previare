# ==============================================================================
# Previare Platform - Root Environment Configuration Template
# ==============================================================================

# PostgreSQL Container Configuration
POSTGRES_USER=previare_user
POSTGRES_PASSWORD=previare_pass
POSTGRES_DB=previare_db
POSTGRES_PORT=5432

# Backend API Configuration
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://previare_user:previare_pass@localhost:5432/previare_db?schema=public
FRONTEND_URL=http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Frontend Next.js Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Frontend — envio do modal "Falar com Especialista" (/api/contato)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=advogados@previare.com.br
CONTACT_FROM_EMAIL=
