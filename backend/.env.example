# ============================================================
# BACKEND — Variáveis de Ambiente
# Copie este arquivo para .env (ou .env.local, que tem prioridade) e preencha os valores
# NUNCA commite .env / .env.local no repositório
# ============================================================

# Ambiente de execução
NODE_ENV=development

# Porta do servidor NestJS
PORT=3001

# URL do banco de dados PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://previare_user:previare_pass@localhost:5432/previare_db?schema=public"

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting (THROTTLE_TTL em milissegundos — @nestjs/throttler v6)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ------------------------------------------------------------
# E-mail de notificação de novos leads (POST /api/leads)
# O lead é sempre salvo no banco; sem MAIL_HOST o e-mail não é enviado
# (em desenvolvimento o conteúdo é apenas impresso no log).
# Ex.: Google Workspace smtp.gmail.com:465 · Microsoft 365 smtp.office365.com:587
# ------------------------------------------------------------
MAIL_TO="contato@amoadvogados.com.br"
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# Remetente (precisa ser autorizado no provedor SMTP; padrão: MAIL_USER)
MAIL_FROM="Previare Notificações <noreply@amoadvogados.com.br>"
