# ============================================================
# BACKEND — Variáveis de Ambiente
# Copie este arquivo para .env (ou .env.local, que tem prioridade) e preencha os valores
# NUNCA commite .env / .env.local no repositório
# ============================================================

# Ambiente de execução
NODE_ENV=development

# Porta do servidor NestJS
PORT=3001

# URL do banco de dados PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://previare_user:previare_pass@localhost:5432/previare_db?schema=public"

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting (THROTTLE_TTL em milissegundos — @nestjs/throttler v6)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
