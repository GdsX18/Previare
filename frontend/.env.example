# ============================================================
# FRONTEND (Next.js) — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite o arquivo .env.local no repositório
# ============================================================

# URL pública do site (usada em metadados, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://previare.com.br

# URL da API backend (pública — usada em chamadas client-side)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ------------------------------------------------------------
# Modal "Falar com Especialista" → rota interna /api/contato
# Envio SMTP (ex.: Google Workspace smtp.gmail.com:465, Microsoft 365 smtp.office365.com:587)
# Sem SMTP_HOST em desenvolvimento, o e-mail é apenas impresso no console.
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Caixa postal que recebe as solicitações dos clientes
CONTACT_TO_EMAIL=advogados@previare.com.br
# Remetente (deve ser autorizado no provedor SMTP; padrão: SMTP_USER)
CONTACT_FROM_EMAIL=
