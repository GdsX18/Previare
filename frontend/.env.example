# ============================================================
# FRONTEND (Next.js) — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite o arquivo .env.local no repositório
# ============================================================

# URL pública do site (usada em metadados, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://previare.com.br

# URL da API backend (pública — usada em chamadas client-side)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ------------------------------------------------------------
# Formulários de contato (rodapé, modal e simulador) → rota interna /api/leads,
# que encaminha ao backend NestJS. O backend salva o lead e envia o e-mail
# para a banca (configuração SMTP em backend/.env — variáveis MAIL_*).
# Apenas servidor (não exposto ao navegador); lido em tempo de execução.
# ------------------------------------------------------------
BACKEND_URL=http://localhost:3001
